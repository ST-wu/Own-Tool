# Playwright 常駐服務配置範本
# 複製此檔案為 .env 並調整相應設定值

# 服務監聽設定 (0.0.0.0 允許區網設備與手機連線)
HOST=0.0.0.0
PORT=8000

# 安全金鑰 (API 訪問防護，客戶端請求需帶 Header: X-API-Key)
API_SECRET_KEY=change-me-to-a-secure-secret-key

# Playwright 瀏覽器核心設定
# HEADLESS: true (背景無頭模式) / false (桌面可視模式，適合本機調試)
HEADLESS=true
BROWSER_TYPE=chromium
MAX_CONCURRENT_CONTEXTS=5
CONTEXT_TIMEOUT_MS=30000

# 日誌與產出目錄
LOG_LEVEL=INFO
ARTIFACTS_DIR=artifacts

# 自動化背景巡檢排程 (秒，設為 0 則停用定時健康巡檢)
SCHEDULE_HEALTH_PROBE_SECONDS=60
